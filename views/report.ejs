<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Rapport — <%= tontine.name %></title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
  body { padding: 30px; }
  @media print { .no-print { display: none; } }
  h1 { color: #1F7A4D; }
</style>
</head>
<body>
  <button class="btn btn-brand no-print mb-3" onclick="window.print()">🖨️ Imprimer / Exporter en PDF</button>
  <h1><%= tontine.name %></h1>
  <p class="text-muted">Rapport généré le <%= generatedAt %> · Période : <%= tontine.start_date %> → en cours</p>

  <h5 class="mt-4">Membres (<%= members.length %>)</h5>
  <table class="table table-sm table-bordered">
    <thead><tr><th>Nom</th><th>Rôle</th><th>Statut</th><th>Entrée</th></tr></thead>
    <tbody>
      <% members.forEach(m => { %>
      <tr><td><%= m.first_name %> <%= m.last_name %></td><td><%= m.role %></td><td><%= m.status %></td><td><%= m.joined_at %></td></tr>
      <% }) %>
    </tbody>
  </table>

  <h5 class="mt-4">Cycles et bénéficiaires</h5>
  <table class="table table-sm table-bordered">
    <thead><tr><th>#</th><th>Échéance</th><th>Bénéficiaire</th><th>Attendu</th><th>Collecté</th><th>Statut</th></tr></thead>
    <tbody>
      <% cycles.forEach(c => { %>
      <tr><td><%= c.cycle_number %></td><td><%= c.due_date %></td><td><%= c.ben_first ? c.ben_first+' '+c.ben_last : '—' %></td><td><%= c.expected_amount %></td><td><%= c.collected_amount %></td><td><%= c.status %></td></tr>
      <% }) %>
    </tbody>
  </table>

  <h5 class="mt-4">Cotisations</h5>
  <table class="table table-sm table-bordered">
    <thead><tr><th>Cycle</th><th>Membre</th><th>Attendu</th><th>Payé</th><th>Date</th><th>Statut</th></tr></thead>
    <tbody>
      <% contributions.forEach(c => { %>
      <tr><td><%= c.cycle_number %></td><td><%= c.first_name %> <%= c.last_name %></td><td><%= c.expected_amount %></td><td><%= c.paid_amount %></td><td><%= c.payment_date || '—' %></td><td><%= c.status %></td></tr>
      <% }) %>
    </tbody>
  </table>

  <h5 class="mt-4">Litiges (<%= disputes.length %>)</h5>
  <table class="table table-sm table-bordered">
    <thead><tr><th>Sujet</th><th>Statut</th><th>Créé le</th><th>Résolution</th></tr></thead>
    <tbody>
      <% disputes.forEach(d => { %>
      <tr><td><%= d.subject %></td><td><%= d.status %></td><td><%= d.created_at %></td><td><%= d.resolution_note || '—' %></td></tr>
      <% }) %>
    </tbody>
  </table>

  <h5 class="mt-4">Membres exclus (<%= excluded.length %>)</h5>
  <table class="table table-sm table-bordered">
    <thead><tr><th>Nom</th><th>Motif</th></tr></thead>
    <tbody>
      <% excluded.forEach(m => { %>
      <tr><td><%= m.first_name %> <%= m.last_name %></td><td><%= m.exclusion_reason || '—' %></td></tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
