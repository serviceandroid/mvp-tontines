<%- include('partials/header') %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow-sm border-0 mt-4">
      <div class="card-body p-4">
        <h4 class="mb-1 fw-bold text-brand">Vérification</h4>
        <p class="text-muted small mb-3">Entrez le code à 6 chiffres envoyé au <%= phone %></p>
        <% if (typeof devCode !== 'undefined' && devCode) { %>
          <div class="alert alert-warning py-2 small">
            <strong>Mode démo :</strong> SMS non branché à un opérateur réel — votre code est <strong><%= devCode %></strong>.
          </div>
        <% } %>
        <% if (error) { %><div class="alert alert-danger py-2 small"><%= error %></div><% } %>
        <form method="POST" action="/otp/verify">
          <input type="hidden" name="phone" value="<%= phone %>">
          <input type="hidden" name="redirectTo" value="<%= redirectTo %>">
          <div class="mb-3">
            <input type="text" name="code" maxlength="6" class="form-control form-control-lg text-center" placeholder="000000" required autofocus>
          </div>
          <button class="btn btn-brand w-100 mb-2">Valider</button>
        </form>
        <form method="POST" action="/otp/resend">
          <input type="hidden" name="phone" value="<%= phone %>">
          <input type="hidden" name="redirectTo" value="<%= redirectTo %>">
          <button class="btn btn-outline-secondary w-100 btn-sm">Renvoyer le code</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
