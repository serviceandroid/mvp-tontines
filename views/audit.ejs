<%- include('partials/header') %>
<%- include('partials/tontine-nav') %>

<h6 class="fw-bold mb-3">Journal d'audit</h6>
<div class="table-responsive">
<table class="table table-sm bg-white shadow-sm small">
  <thead><tr><th>Date</th><th>Acteur</th><th>Action</th><th>Entité</th><th>Avant</th><th>Après</th></tr></thead>
  <tbody>
  <% logs.forEach(l => { %>
    <tr>
      <td><%= l.created_at %></td>
      <td><%= l.first_name ? l.first_name + ' ' + l.last_name : (l.actor_user_id === 'system' ? 'Système' : l.actor_user_id) %></td>
      <td><%= l.action %></td>
      <td><%= l.entity || '—' %></td>
      <td class="text-truncate" style="max-width:180px;"><%= l.old_value || '—' %></td>
      <td class="text-truncate" style="max-width:180px;"><%= l.new_value || '—' %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>

<%- include('partials/footer') %>
